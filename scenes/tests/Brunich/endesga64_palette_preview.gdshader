shader_type canvas_item;
render_mode unshaded;

uniform sampler2D screen_tex : hint_screen_texture, filter_nearest;
uniform float preview_strength : hint_range(0.0, 1.0) = 1.0;
uniform float luma_weight : hint_range(0.0, 0.5) = 0.12;

const int PALETTE_SIZE = 64;
const vec3 ENDESGA64[PALETTE_SIZE] = vec3[](
