float palette_luma(vec3 color) {
	return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

vec3 remap_to_endesga64(vec3 input_color) {
	vec3 best_color = ENDESGA64[0];
	float source_luma = palette_luma(input_color);
	float best_score = 999999.0;

	for (int i = 0; i < PALETTE_SIZE; i++) {
		vec3 candidate = ENDESGA64[i];
		vec3 delta = input_color - candidate;
		float rgb_score = dot(delta, delta);
		float luma_score = abs(source_luma - palette_luma(candidate));
		float score = rgb_score + (luma_score * luma_weight);
		if (score < best_score) {
			best_score = score;
			best_color = candidate;
		}
	}

	return best_color;
}

void fragment() {
	vec4 screen = texture(screen_tex, SCREEN_UV);
	vec3 mapped = remap_to_endesga64(screen.rgb);
	COLOR = vec4(mix(screen.rgb, mapped, preview_strength), screen.a);
}
